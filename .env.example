# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Tella: Settings -> API in Tella
TELLA_API_KEY=

# Epidemic Sound Partner API key (server-side key) and the partner user id to send with requests
EPIDEMIC_API_KEY=
EPIDEMIC_USER_ID=

# Optional overrides (normally leave unset)
# TELLA_API_BASE=https://api.tella.com/v1
# EPIDEMIC_API_BASE=https://partner-content-api.epidemicsound.com
